# Backend environment variables example
# Copy to backend/.env and fill values for your environment

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=changeme
PGDATABASE=ssmm_db

# Mailer (nodemailer) - development using Ethereal or SMTP credentials
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=you@example.com
MAIL_PASS=secret
MAIL_FROM=you@example.com

# Turnstile (optional)
VITE_TURNSTILE_SITE_KEY=

# Session / JWT settings
# IMPORTANT: set a strong secret in production (min 32 random bytes)
JWT_SECRET=replace_with_a_strong_random_value_of_at_least_32_chars
NODE_ENV=development
# Session expiration for access token (eg '1h', '15m')
SESSION_EXPIRES_IN=1h
# Session cookie max age in ms
SESSION_MAX_AGE_MS=3600000
# Refresh token max age in ms (30 days default)
SESSION_REFRESH_MAX_AGE_MS=2592000000
# Adjust SameSite policy: In production you MUST use 'none' when serving cross-site cookies.
# This example forces `none` to make cross-site session cookies explicit. Ensure `JWT_SECRET`
# and `NODE_ENV=production` are configured and that HTTPS is used (secure cookies required).
SESSION_SAME_SITE=none

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:5173

# Microsoft / Microsoft Graph (Outlook) integration
# Register an app in Azure AD (App registrations) and set these values in backend/.env
# Redirect URI example for local development: http://localhost:4000/api/graph/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
# Optional: scopes to request (space-separated)
MICROSOFT_SCOPES=offline_access openid profile User.Read Contacts.Read
